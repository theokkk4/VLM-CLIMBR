# Copy to `.env` and paste your VLM Run key:
#     cp .env.example .env
#
# Get one at https://app.vlm.run — Settings -> API keys.
# `.env` is gitignored. An exported VLMRUN_API_KEY overrides this file.
VLMRUN_API_KEY=

# Optional overrides
# VLMRUN_BASE_URL=https://gateway.vlm.run/v1/openai
# CLIMBR_COACH_MODEL=google/gemini-3.7-flash
# CLIMBR_API_PORT=8787
