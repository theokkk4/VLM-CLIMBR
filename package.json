{
  "name": "climbr",
  "version": "0.1.0",
  "private": true,
  "description": "CLIMBR — read every move. A rock-climbing analysis app built on VLM Run (SAM 3.1 + ViTPose+), with iPhone LiDAR support.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --prod",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@vercel/blob": "^2.8.0",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^13.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.49.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
